  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request in the collection.",
          "// Optional: warn if the base_url looks wrong.",
          "const base = pm.environment.get('base_url') || pm.collectionVariables.get('base_url');",
          "if (!base) {",
          "    console.warn('base_url is not set. Set it in the environment or collection variables.');",
          "}",
          "if (!/^https?:\\/\\//.test(base)) {",
          "    console.warn('base_url should start with http:// or https://');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request.",
          "// Basic sanity checks that produce red/green in the Postman runner.",
          "if (pm.response.code === 200) {",
          "    pm.test('status 200', () => pm.response.to.have.status(200));",
          "}",
          "",
          "// For /health: assert ok === true",
          "if (pm.request.url.path.includes('health')) {",
          "    pm.test('health ok', () => {",
          "        const body = pm.response.json();",
          "        pm.expect(body.ok).to.eql(true);",
          "        pm.expect(body.chrome.reachable).to.eql(true);",
          "        pm.expect(body.session.valid).to.eql(true);",
          "    });",
          "}",
          "",
          "// For /fetch: assert rows returned and not expired",
          "if (pm.request.url.path.includes('fetch')) {",
          "    pm.test('fetch returned rows', () => {",
          "        const body = pm.response.json();",
          "        pm.expect(body.count).to.be.above(0);",
          "        pm.expect(body.expired).to.eql(false);",
          "        pm.expect(body.rows).to.be.an('array');",
          "    });",
          "    pm.test('fetch completed in < 60s', () => {",
          "        const body = pm.response.json();",
          "        pm.expect(body.elapsed_seconds).to.be.below(60);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8099",
      "type": "string"
    },
    {
      "key": "reels_json",
      "value": "[]",
      "type": "string"
    }
  ]
}