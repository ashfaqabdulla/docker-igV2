            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"https://www.instagram.com/reel/DdPARTIoW65/\"\n  ],\n  \"batch_size\": 10,\n  \"pool_size\": 10,\n  \"session\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/fetch",
          "host": ["{{base_url}}"],
          "path": ["fetch"]
        },
        "description": "Recommended tuning for 68+ reels: batch_size=10, pool_size=10. Fastest observed configuration."
      },
      "response": []
