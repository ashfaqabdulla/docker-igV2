          "raw": "{\n  \"urls\": {{reels_json}},\n  \"batch_size\": 10,\n  \"pool_size\": 10,\n  \"session\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/fetch",
          "host": ["{{base_url}}"],
          "path": ["fetch"]
        },
        "description": "Bulk fetch. Set the reels_json environment variable to a JSON array of URLs, e.g. [\"https://...\",\"https://...\"]. Useful for large lists built outside Postman."
      },
      "response": []
    },
