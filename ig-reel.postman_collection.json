{
  "info": {
    "_postman_id": "b7e8a1c4-2f5d-4e9a-8c3b-6d2f1a9e4b7c",
    "name": "ig-reel",
    "description": "Instagram reel metrics scraper API. Requires SSH tunnel on 127.0.0.1:8099 or a direct URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Liveness + readiness. Reports Chrome reachability and session validity."
      },
      "response": []
    },
    {
      "name": "Session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/session",
          "host": ["{{base_url}}"],
          "path": ["session"]
        },
        "description": "Session file status only. Does not probe Chrome."
      },
      "response": []
    },
    {
      "name": "Fetch - single reel",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"https://www.instagram.com/reel/DdPARTIoW65/\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/fetch",
          "host": ["{{base_url}}"],
          "path": ["fetch"]
        },
        "description": "Fetch metrics for one reel. Uses default batch_size=10, pool_size=10, session=true."
      },
      "response": []
    },
    {
      "name": "Fetch - multiple reels",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"urls\": [\n    \"https://www.instagram.com/reel/DdPARTIoW65/\",\n    \"https://www.instagram.com/reel/DdmAv74Cv3_/\",\n    \"https://www.instagram.com/reel/DcgX9eAh27h/\",\n    \"https://www.instagram.com/kyliejenner/reel/Dd_oMDgu6Xd/\"\n  ],\n  \"batch_size\": 10,\n  \"pool_size\": 10,\n  \"session\": true\n}",
